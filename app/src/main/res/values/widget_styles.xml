<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetMeterColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- One glass with its reading, drawn as a single bitmap in UsageWidgets. -->
    <style name="WidgetMeter">
        <!-- Fills its column and shrinks to fit when four glasses share a narrow widget (never grows past its bitmap). -->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>
</resources>
