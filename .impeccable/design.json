  "components": [
    {
      "name": "Filled Plate Button",
      "kind": "button",
      "refersTo": "plate-button-filled",
      "description": "The one main action in a view: an ink plate with a bench-colored label.",
      "html": "<button class=\"ds-plate-filled\">Connect an account</button>",
      "css": ".ds-plate-filled{font-family:'Inter',system-ui,sans-serif;background:#EDE3D2;color:#14110E;border:none;border-radius:3px;min-height:48px;min-width:48px;padding:12px 22px;font-size:14px;font-weight:600;line-height:20px;cursor:pointer;transition:box-shadow .2s} .ds-plate-filled:hover{box-shadow:inset 0 0 0 100px rgba(20,17,14,.09)} .ds-plate-filled:active{box-shadow:inset 0 0 0 100px rgba(20,17,14,.18)} .ds-plate-filled:focus-visible{outline:2px solid #EDE3D2;outline-offset:2px}"
    },
    {
      "name": "Outline Plate Button",
      "kind": "button",
      "refersTo": "plate-button-outline",
      "description": "Secondary action: ink hairline at 55% around an ink label.",
      "html": "<button class=\"ds-plate-outline\">Sign out</button>",
      "css": ".ds-plate-outline{font-family:'Inter',system-ui,sans-serif;background:transparent;color:#EDE3D2;border:1px solid rgba(237,227,210,.55);border-radius:3px;min-height:48px;padding:12px 22px;font-size:14px;font-weight:600;line-height:20px;cursor:pointer;transition:background .2s} .ds-plate-outline:hover{background:rgba(237,227,210,.09)} .ds-plate-outline:focus-visible{outline:2px solid #EDE3D2;outline-offset:0}"
    },
    {
      "name": "Quiet Plate Button",
      "kind": "button",
      "refersTo": "plate-button-quiet",
      "description": "Minor action: underlined ink label, no plate.",
      "html": "<button class=\"ds-plate-quiet\">Cancel</button>",
      "css": ".ds-plate-quiet{font-family:'Inter',system-ui,sans-serif;background:transparent;color:#EDE3D2;border:none;border-radius:3px;min-height:48px;padding:12px;font-size:14px;font-weight:600;text-decoration:underline;cursor:pointer;transition:background .2s} .ds-plate-quiet:hover{background:rgba(237,227,210,.09)} .ds-plate-quiet:focus-visible{outline:2px solid #EDE3D2}"
    },
    {
      "name": "Scale Selector",
      "kind": "chip",
      "refersTo": "scale-selector",
      "description": "Engraved cells; an inverted ink plate slides to the chosen one.",
      "html": "<div class=\"ds-scale\" role=\"radiogroup\"><button class=\"ds-scale-cell\" role=\"radio\" aria-checked=\"false\">System</button><button class=\"ds-scale-cell ds-on\" role=\"radio\" aria-checked=\"true\">Light</button><button class=\"ds-scale-cell\" role=\"radio\" aria-checked=\"false\">Dark</button></div>",
      "css": ".ds-scale{display:flex;height:48px;width:320px;border:1px solid #8C7F6C;border-radius:3px;overflow:hidden;background:#14110E} .ds-scale-cell{font-family:'Inter',system-ui,sans-serif;flex:1;background:transparent;color:#EDE3D2;border:none;border-left:1px solid rgba(140,127,108,.5);font-size:14px;font-weight:500;cursor:pointer;transition:background .25s cubic-bezier(.34,1.4,.64,1),color .2s} .ds-scale-cell:first-child{border-left:none} .ds-scale-cell:hover{background:rgba(237,227,210,.09)} .ds-scale-cell.ds-on{background:#EDE3D2;color:#14110E;font-weight:600} .ds-scale-cell:focus-visible{outline:2px solid #EDE3D2;outline-offset:-2px}"
    },
    {
      "name": "Glass Toggle",
      "kind": "custom",
      "refersTo": "glass-toggle",
      "description": "A square-shouldered lever whose block springs across and fills with ink.",
      "html": "<button class=\"ds-toggle\" role=\"switch\" aria-checked=\"true\"><span class=\"ds-toggle-block\"></span></button>",
      "css": ".ds-toggle{position:relative;width:54px;height:32px;border:1.25px solid #8C7F6C;border-radius:3px;background:#29241E;cursor:pointer;padding:0} .ds-toggle-block{position:absolute;top:4px;left:26px;width:22px;height:22px;border-radius:2px;background:#EDE3D2;transition:left .35s cubic-bezier(.34,1.56,.64,1)} .ds-toggle[aria-checked=false]{background:transparent} .ds-toggle[aria-checked=false] .ds-toggle-block{left:4px;background:#14110E;box-shadow:inset 0 0 0 1.25px #8C7F6C} .ds-toggle:focus-visible{outline:2px solid #EDE3D2;outline-offset:2px}"
    },
    {
      "name": "Bench Bar",
      "kind": "nav",
      "refersTo": "bench-bar",
      "description": "Three glyph tabs on the bench with a sliding ink rule.",
      "html": "<nav class=\"ds-bar\"><a class=\"ds-tab ds-on\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"><path d=\"M5.5 3.5h13M5.5 20.5h13M7.5 3.5C7.5 9 11 10 11 12s-3.5 3-3.5 8.5M16.5 3.5C16.5 9 13 10 13 12s3.5 3 3.5 8.5\"/><path d=\"M9 18.8l3-2.6 3 2.6z\" fill=\"currentColor\"/></svg>Usage</a><a class=\"ds-tab\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"><circle cx=\"5\" cy=\"6\" r=\"1.7\" fill=\"currentColor\" stroke=\"none\"/><circle cx=\"5\" cy=\"12\" r=\"1.7\" fill=\"currentColor\" stroke=\"none\"/><circle cx=\"5\" cy=\"18\" r=\"1.7\" fill=\"currentColor\" stroke=\"none\"/><path d=\"M9.5 6H20M9.5 12H20M9.5 18H20\"/></svg>Accounts</a><a class=\"ds-tab\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"><path d=\"M3 15h18M4 15v3.5M8 15v3.5M12 15v3.5M16 15v3.5M20 15v3.5M14 4.5V15\"/><circle cx=\"14\" cy=\"5\" r=\"2.2\" fill=\"currentColor\" stroke=\"none\"/></svg>Settings</a></nav>",
      "css": ".ds-bar{display:flex;width:360px;height:68px;background:#14110E;border-top:1px solid #3A332B} .ds-tab{font-family:'Inter',system-ui,sans-serif;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:#AB9D88;font-size:12px;font-weight:500;position:relative;cursor:pointer;transition:color .2s} .ds-tab svg{transition:transform .3s cubic-bezier(.34,1.8,.64,1)} .ds-tab:hover{color:#EDE3D2} .ds-tab.ds-on{color:#EDE3D2;font-weight:600} .ds-tab.ds-on svg{transform:translateY(-2px)} .ds-tab.ds-on::before{content:'';position:absolute;top:0;width:28px;height:3px;background:#EDE3D2;border-radius:0 0 2px 2px} .ds-tab:focus-visible{outline:2px solid #EDE3D2;outline-offset:-2px}"
    },
    {
      "name": "Errata Slip",
      "kind": "custom",
      "refersTo": "errata-slip",
      "description": "A failed read hung under its glass: the one surface the alert color fills.",
      "html": "<div class=\"ds-slip\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3.5l9 16H3z\"/><path d=\"M12 9.5V14\"/><circle cx=\"12\" cy=\"16.8\" r=\"1.1\" fill=\"currentColor\" stroke=\"none\"/></svg><span>Claude sign-in expired. Showing the last reading.</span><button>Sign in</button></div>",
      "css": ".ds-slip{font-family:'Inter',system-ui,sans-serif;display:flex;align-items:center;width:340px;background:#3A1A12;color:#FFD9CF;border-radius:3px;padding:4px 4px 4px 12px} .ds-slip span{flex:1;padding:10px;font-size:12px;line-height:16px} .ds-slip button{font-family:'Inter',system-ui,sans-serif;background:transparent;color:#FFD9CF;border:none;min-height:48px;padding:0 12px;font-size:14px;font-weight:600;text-decoration:underline;cursor:pointer;border-radius:3px} .ds-slip button:hover{background:rgba(255,217,207,.09)} .ds-slip button:focus-visible{outline:2px solid #FFD9CF}"
    },
    {
      "name": "Glass Reading (tall)",
      "kind": "custom",
      "refersTo": "glass-tall",
      "description": "Signature: a quota window as a sand glass with its 40sp engraved numeral, label and reset.",
      "html": "<div class=\"ds-reading\"><svg width=\"64\" height=\"148\" viewBox=\"0 0 64 148\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"b\" x1=\"0\" x2=\"1\"><stop offset=\"0\" stop-color=\"#8C7F6C\" stop-opacity=\".16\"/><stop offset=\".3\" stop-color=\"#EDE3D2\" stop-opacity=\".05\"/><stop offset=\".7\" stop-color=\"#EDE3D2\" stop-opacity=\".05\"/><stop offset=\"1\" stop-color=\"#8C7F6C\" stop-opacity=\".16\"/></linearGradient><clipPath id=\"u\"><path d=\"M9 8H55C55 39 35 57 35 74H29C29 57 9 39 9 8Z\"/></clipPath><clipPath id=\"l\"><path d=\"M9 137H55C55 106 35 91 35 74H29C29 91 9 106 9 137Z\"/></clipPath></defs><ellipse cx=\"32\" cy=\"146\" rx=\"30\" ry=\"2.5\" fill=\"#000\" opacity=\".5\"/><path d=\"M9 8H55C55 39 35 57 35 74H29C29 57 9 39 9 8Z M9 137H55C55 106 35 91 35 74H29C29 91 9 106 9 137Z\" fill=\"url(#b)\"/><rect x=\"0\" y=\"16.1\" width=\"64\" height=\"57.9\" fill=\"#DDB061\" clip-path=\"url(#u)\"/><rect x=\"0\" y=\"128.9\" width=\"64\" height=\"8.1\" fill=\"#DDB061\" clip-path=\"url(#l)\"/><line x1=\"32\" y1=\"74\" x2=\"32\" y2=\"128.9\" stroke=\"#DDB061\" stroke-opacity=\".55\"/><path d=\"M9 8H55C55 39 35 57 35 74H29C29 57 9 39 9 8Z M9 137H55C55 106 35 91 35 74H29C29 91 9 106 9 137Z\" fill=\"none\" stroke=\"#8C7F6C\" stroke-width=\"1.25\"/><g stroke=\"#8C7F6C\" stroke-width=\"1.25\"><line x1=\"0\" x2=\"7\" y1=\"41\" y2=\"41\"/><line x1=\"0\" x2=\"7\" y1=\"27.3\" y2=\"27.3\"/><line x1=\"0\" x2=\"7\" y1=\"16.8\" y2=\"16.8\"/></g><line x1=\"0\" x2=\"64\" y1=\"37.9\" y2=\"37.9\" stroke=\"#FF6A4D\" stroke-width=\"1.25\" stroke-dasharray=\"3 2\"/><path d=\"M13.5 16C13.5 38 22 50 26 63\" fill=\"none\" stroke=\"#fff\" stroke-opacity=\".22\" stroke-width=\"2.2\" stroke-linecap=\"round\"/><rect x=\"0\" y=\"0\" width=\"64\" height=\"8\" rx=\"2.8\" fill=\"#3B342C\"/><rect x=\"0\" y=\"137\" width=\"64\" height=\"8\" rx=\"2.8\" fill=\"#3B342C\"/><line x1=\"2.4\" x2=\"61.6\" y1=\".5\" y2=\".5\" stroke=\"#6E6354\"/></svg><div class=\"ds-num\">77%<small>left</small></div><div class=\"ds-lab\">Weekly</div><div class=\"ds-reset\">Resets in 1d 13h</div></div>",
      "css": ".ds-reading{background:#14110E;padding:20px;width:180px} .ds-reading svg{transition:transform .9s cubic-bezier(.34,1.3,.64,1)} .ds-reading:hover svg{transform:rotate(360deg)} .ds-num{font-family:'Barlow Condensed','Roboto Condensed',sans-serif;font-size:40px;line-height:42px;font-weight:600;letter-spacing:-.5px;color:#EDE3D2;font-variant-numeric:tabular-nums;margin-top:14px} .ds-num small{font-family:'Inter',system-ui,sans-serif;font-size:12px;font-weight:500;color:#AB9D88;margin-left:4px;letter-spacing:0} .ds-lab{font-family:'Inter',system-ui,sans-serif;font-size:14px;font-weight:500;color:#EDE3D2} .ds-reset{font-family:'Inter',system-ui,sans-serif;font-size:12px;color:#AB9D88}"
    },
    {
      "name": "Bench Dialog",
      "kind": "card",
      "refersTo": "bench-dialog",
      "description": "A bench slip that springs up from the table: raised tone, hairline rim, no shadow.",
      "html": "<div class=\"ds-dialog\"><h3>Sign out of Codex?</h3><p>Its cached usage is replaced with a disconnected placeholder.</p><div class=\"ds-dialog-actions\"><button class=\"ds-q\">Cancel</button><button class=\"ds-f\">Sign out</button></div></div>",
      "css": ".ds-dialog{background:#1E1A16;border:1px solid rgba(140,127,108,.6);border-radius:4px;padding:24px 12px 12px 24px;width:320px;animation:ds-rise .5s cubic-bezier(.34,1.4,.64,1)} @keyframes ds-rise{from{transform:translateY(48px) scale(.94);opacity:0}} .ds-dialog h3{font-family:'Barlow Condensed','Roboto Condensed',sans-serif;font-size:22px;line-height:26px;font-weight:600;color:#EDE3D2;margin:0 12px 14px 0} .ds-dialog p{font-family:'Inter',system-ui,sans-serif;font-size:14px;line-height:20px;color:#AB9D88;margin:0 12px 14px 0} .ds-dialog-actions{display:flex;justify-content:flex-end;gap:4px} .ds-dialog button{font-family:'Inter',system-ui,sans-serif;min-height:48px;border:none;border-radius:3px;font-size:14px;font-weight:600;cursor:pointer} .ds-q{background:transparent;color:#EDE3D2;text-decoration:underline;padding:0 12px} .ds-f{background:#EDE3D2;color:#14110E;padding:12px 22px} .ds-dialog button:focus-visible{outline:2px solid #EDE3D2;outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Running Glass",
    "overview": "TokenWatch is a bench of blown sand glasses. Each quota window the provider reports is one glass: sand in the upper bulb is what is left, sand in the lower bulb is what is used, and refreshing turns the glass. The bench is smoked bronze in dark mode and cool porcelain in light mode; both are first-class. Glasses are drawn at runtime as premium objects (wall-gradient body, inner rim, curved highlight streaks, dark-metal caps, a soft contact shadow) and the sand is grained, dished in the upper bulb and heaped in the lower, in each provider's own color.\n\nThe feel is playful and premium: delightful to touch, expensive to look at. Play lives in physical motion (grains falling through every running glass, sand levelling with the phone's tilt, sprung flips, haptic ticks), never in decoration. Premium lives in restraint: one ink, hairline rules, one alert color held back, engraved condensed numerals. No stock Android or Material element is visible anywhere. Material 3 is invisible plumbing only (MaterialTheme as the token store, Scaffold layout, the PullToRefresh gesture, the Snackbar slot); every control the user sees is drawn by the app.\n\nDensity is a ruled rack, not a card grid. Sections and provider shelves are separated by one-pixel hairline rules on the bench; nothing floats in a container. Rank comes from glass size and order, never from shrinking a number.",
    "keyCharacteristics": [
      "Every quota window is a sand glass; percent left is the upper bulb, area-correct (sqrt mapping).",
      "One ink (the text color) does every control job; provider sands are the only hues; vermilion means alert and nothing else.",
      "Barlow Condensed engraved face for titles and numerals; Inter for prose; tabular figures everywhere.",
      "Hairline rules instead of cards; flat bench with drawn objects on it.",
      "Springs and haptics on every control; Remove animations stills all of it."
    ],
    "rules": [
      {
        "name": "The Held-Back Vermilion Rule",
        "body": "The alert color appears only for alerts: the alert line, a past-the-line numeral, an errata slip. A screen with nothing past its line shows no vermilion at all.",
        "section": "colors"
      },
      {
        "name": "The One Ink Rule",
        "body": "Controls are ink on bench or bench on ink. No control takes a provider sand or a third hue.",
        "section": "colors"
      },
      {
        "name": "The Sand Is the Provider Rule",
        "body": "A provider's color lives in its sand. Provider marks carry the provider's own artwork; the OpenAI mark is monochrome and follows the ink.",
        "section": "colors"
      },
      {
        "name": "The One Numeral Rule",
        "body": "Every percent is 40sp Barlow Condensed. Rank is carried by weight, glass size and order; a number is never shrunk to make it less important.",
        "section": "typography"
      },
      {
        "name": "The Engraved Heading Rule",
        "body": "Headings and numerals are Barlow Condensed; prose and controls are Inter. Never set a sentence in the condensed face.",
        "section": "typography"
      },
      {
        "name": "The Flat Bench Rule",
        "body": "Screens, rows, sections and dialogs cast no shadow. Only the glass casts a shadow, because it is the only object standing on the bench.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** show every quota window as a sand glass drawn with the shared glass routine, sand in the provider's color.",
      "**Do** set every percent at the one 40sp Barlow Condensed numeral, with tabular figures, rolling in the direction it moved.",
      "**Do** separate groups with a 1dp hairline rule on the bench and a 20dp gutter.",
      "**Do** draw every visible control in the app's own vocabulary (plate buttons, glass toggle, scale selector, scale slider, bench bar, bench dialog, glyphs, ink wash) with 48dp targets and proper accessibility roles.",
      "**Do** answer controls with springs and haptic ticks, and check `motionEnabled()` so Remove animations stills grains, tilt, spins, flips and entrances.",
      "**Do** show stale readings as stale: dashed outline, half-strength sand, an errata slip."
    ],
    "donts": [
      "**Don't** let any stock Material or Android element show: no ripple, no stretch overscroll, no Material buttons, switches, sliders, segmented buttons, navigation bar, top app bar, dialogs or icon packs.",
      "**Don't** use cards, elevated containers or surface shadows; only the glass casts a shadow.",
      "**Don't** use the alert vermilion for anything but alerts.",
      "**Don't** shrink a numeral to signal lower rank; use glass size, weight and order.",
      "**Don't** fall back to a horizontal progress bar for usage.",
      "**Don't** give controls a provider sand or a brand hue; controls are ink."
    ]
  }
}
